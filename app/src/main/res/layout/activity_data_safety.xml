<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/data_safety_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/data_safety_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/inkNoteToolbarBackground"
        app:navigationContentDescription="@string/back_to_library"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="?attr/inkNoteIconColor"
        app:title="@string/data_safety"
        app:titleTextColor="?attr/inkNoteTextPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_explanation"
                android:textColor="?attr/inkNoteTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/backup_folder_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="16dp"
                android:textColor="?attr/inkNoteTextPrimary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/last_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/inkNoteTextSecondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/choose_backup_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/choose_backup_folder"
                app:icon="@drawable/ic_folder_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backup_now"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/backup_now"
                app:icon="@drawable/ic_timer_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cleanup_backups"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cleanup_backups" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vault_transfer_explanation"
                android:textColor="?attr/inkNoteTextPrimary"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/export_vault"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/export_all_notes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restore_vault"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/restore_from_archive" />

            <TextView
                android:id="@+id/data_safety_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/inkNoteTextSecondary"
                android:textIsSelectable="true"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
