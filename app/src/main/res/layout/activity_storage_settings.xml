<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storage_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/storage_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/inkNoteToolbarBackground"
        app:navigationContentDescription="@string/back_to_library"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="?attr/inkNoteIconColor"
        app:title="@string/note_storage"
        app:titleTextColor="?attr/inkNoteTextPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shared_storage_explanation"
                android:textColor="?attr/inkNoteTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/shared_storage_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="16dp"
                android:textColor="?attr/inkNoteTextPrimary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shared_storage_choose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/shared_storage_choose"
                app:icon="@drawable/ic_folder_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shared_storage_sync"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/shared_storage_sync_now"
                app:icon="@drawable/ic_cloud_sync_24" />

            <TextView
                android:id="@+id/shared_storage_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/inkNoteTextSecondary"
                android:textIsSelectable="true"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
