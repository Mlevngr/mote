<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/inkNoteToolbarBackground"
        app:navigationIconTint="?attr/inkNoteTextPrimary"
        app:titleTextColor="?attr/inkNoteTextPrimary">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/insert_asset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/insert_asset"
                android:padding="12dp"
                android:src="@drawable/ic_link_24"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toggle_mode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_to_edit_mode"
                android:padding="12dp"
                android:src="@drawable/ic_edit_24"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <com.mlevngr.inknote.ui.ImeBackTextInputEditText
        android:id="@+id/note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:ellipsize="end"
        android:hint="@string/note_title_hint"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textColor="?attr/inkNoteTextPrimary"
        android:textColorHint="?attr/inkNoteTextSecondary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/note_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="32dp"
        android:scrollbars="vertical" />

</LinearLayout>
