<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/inkNoteToolbarBackground"
        app:navigationContentDescription="@string/back_to_library"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="?attr/inkNoteTextPrimary"
        app:titleTextColor="?attr/inkNoteTextPrimary">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/plugins"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/plugins"
                android:padding="12dp"
                android:src="@drawable/ic_extension_24"
                android:visibility="gone"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/insert_asset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/insert_asset"
                android:padding="12dp"
                android:src="@drawable/ic_link_24"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toggle_mode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_to_edit_mode"
                android:padding="12dp"
                android:src="@drawable/ic_edit_24"
                app:tint="?attr/inkNoteIconColor" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <com.mlevngr.inknote.ui.NoteCanvasZoomLayout
        android:id="@+id/note_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.mlevngr.inknote.ui.ImeBackTextInputEditText
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inkNoteToolbarBackground"
                android:ellipsize="end"
                android:hint="@string/note_title_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp"
                android:singleLine="true"
                android:textColor="?attr/inkNoteTextPrimary"
                android:textColorHint="?attr/inkNoteTextSecondary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.35"
                android:background="?attr/colorOutline" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/note_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="32dp"
                android:scrollbars="vertical" />

        </LinearLayout>

    </com.mlevngr.inknote.ui.NoteCanvasZoomLayout>

    <HorizontalScrollView
        android:id="@+id/markdown_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceContainer"
        android:clipToPadding="false"
        android:contentDescription="@string/markdown_toolbar"
        android:elevation="4dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/undo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/undo"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_undo_24"
                android:visibility="gone"
                android:tooltipText="@string/undo"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/redo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/redo"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_redo_24"
                android:visibility="gone"
                android:tooltipText="@string/redo"
                app:tint="?attr/inkNoteIconColor" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:alpha="0.5"
                android:background="?attr/colorOutline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markdown_heading"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:focusable="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="76dp"
                android:text="@string/markdown_body"
                android:textAllCaps="false"
                android:tooltipText="@string/markdown_heading"
                app:icon="@drawable/ic_arrow_drop_down_24"
                app:iconGravity="textEnd"
                app:iconPadding="4dp"
                app:iconSize="18dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_bold"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_bold"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_format_bold_24"
                android:tooltipText="@string/markdown_bold"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_italic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_italic"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_format_italic_24"
                android:tooltipText="@string/markdown_italic"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_strikethrough"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_strikethrough"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_format_strikethrough_24"
                android:tooltipText="@string/markdown_strikethrough"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_task"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_task"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_checklist_24"
                android:tooltipText="@string/markdown_task"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_bullet_list"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_bullet_list"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_format_list_bulleted_24"
                android:tooltipText="@string/markdown_bullet_list"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_numbered_list"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_numbered_list"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_format_list_numbered_24"
                android:tooltipText="@string/markdown_numbered_list"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_quote"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_quote"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_format_quote_24"
                android:tooltipText="@string/markdown_quote"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_inline_code"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_inline_code"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_code_24"
                android:tooltipText="@string/markdown_inline_code"
                app:tint="?attr/inkNoteIconColor" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/markdown_link"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/markdown_link"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_link_24"
                android:tooltipText="@string/markdown_link"
                app:tint="?attr/inkNoteIconColor" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
