<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_local_organizer"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_local_organizer"
        android:supportsRtl="true">

        <service
            android:name=".LocalOrganizerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.mlevngr.mote.action.PLUGIN_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="com.mlevngr.mote.plugin.API_VERSION"
                android:value="1" />
            <meta-data
                android:name="com.mlevngr.mote.plugin.ID"
                android:value="mote.local.organizer" />
            <meta-data
                android:name="com.mlevngr.mote.plugin.LABEL"
                android:value="Mote 本地整理" />
        </service>
    </application>
</manifest>
